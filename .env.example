# Copy this file to .env in the repository root, then fill in your Nebius key.
# .env is ignored by Git. Never place keys in frontend files or VITE_* variables.
# Existing process environment variables take precedence over this file.

NEBIUS_API_KEY=

# STUB uses approved fictional extraction packets without provider calls.
# Change to LIVE when you want the backend to call Nebius.
PK_AGENT_MODE=STUB

# Candidate model; live evaluation must confirm access and extraction correctness.
PK_NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Live pytest also requires PK_ALLOW_LIVE_TESTS=1 in the process environment.
# The explicit evaluate --suite live command makes real calls independently.
PK_ALLOW_LIVE_TESTS=0

# Optional: absolute database path inside this repository. Omit to use .runtime.
# PK_DB_PATH=E:/maai-projects/promisekeeper/.runtime/promisekeeper.sqlite

# --- Multi-agent upgrade (all optional) ---
# Tone reviewer provider: NEBIUS (default) or FIREWORKS. Fireworks gives an independent second model.
PK_REVIEWER_PROVIDER=NEBIUS
FIREWORKS_API_KEY=
PK_FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b

# Planning supervisor model for the morning review. Empty uses PK_NEBIUS_MODEL. It only picks one of a few
# code-validated moves from structured facts, so a smaller model may suffice; compare with
# `evaluate --suite supervisor` (LIVE calls) before changing it.
PK_SUPERVISOR_MODEL=

# LangSmith tracing and owner feedback. Exported only when the server starts.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=promisekeeper

# Hosted client memory (LIVE only). Without it, memory stays in local SQLite.
MEM0_API_KEY=

# Minutes between autonomous morning reviews; 0 keeps them off. LIVE runs spend model credits.
PK_AUTONOMOUS_REVIEW_MINUTES=0

# Optional USD per million tokens, so the trace can show cost: model=input:output;model=input:output
# PK_TOKEN_RATES=zai-org/GLM-5.3-Flash=0.10:0.40

# Copy this file to .env in the repository root, then fill in your Nebius key.
# .env is ignored by Git. Never place keys in frontend files or VITE_* variables.
# Existing process environment variables take precedence over this file.

NEBIUS_API_KEY=

# STUB uses approved fictional extraction packets without provider calls.
# Change to LIVE when you want the backend to call Nebius.
PK_AGENT_MODE=STUB

# Candidate model; live evaluation must confirm access and extraction correctness.
PK_NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Live pytest also requires PK_ALLOW_LIVE_TESTS=1 in the process environment.
# The explicit evaluate --suite live command makes real calls independently.
PK_ALLOW_LIVE_TESTS=0

# Optional: absolute database path inside this repository. Omit to use .runtime.
# PK_DB_PATH=E:/maai-projects/promisekeeper/.runtime/promisekeeper.sqlite

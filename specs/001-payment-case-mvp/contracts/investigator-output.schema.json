{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Investigator candidate extraction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "commitments", "payment_claims", "contradictions", "unresolved"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1"]},
    "snapshot_id": {"type": "string"},
    "commitments": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/commitment"}},
    "payment_claims": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/claim"}},
    "contradictions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/contradiction"}},
    "unresolved": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/unresolved"}}
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_version_id", "source_id", "start", "end", "quote"],
      "properties": {
        "evidence_version_id": {"type": "string"},
        "source_id": {"type": "string"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 8000}
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "commitment_key", "source", "speaker", "amount_text", "currency_text", "date_text", "explicitly_replaces_source_id"],
      "properties": {
        "candidate_id": {"type": "string"},
        "commitment_key": {"type": ["string", "null"], "description": "Approved source-version anchor key from the snapshot, or null if unresolved. Runtime validation binds identity independently of candidate IDs and quote boundaries."},
        "source": {"$ref": "#/$defs/span"},
        "speaker": {"type": ["string", "null"]},
        "amount_text": {"type": ["string", "null"]},
        "currency_text": {"type": ["string", "null"]},
        "date_text": {"type": ["string", "null"]},
        "explicitly_replaces_source_id": {"type": ["string", "null"]}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "source", "speaker", "amount_text", "currency_text", "payment_date_text", "transaction_reference_text"],
      "properties": {
        "candidate_id": {"type": "string"},
        "source": {"$ref": "#/$defs/span"},
        "speaker": {"type": ["string", "null"]},
        "amount_text": {"type": ["string", "null"]},
        "currency_text": {"type": ["string", "null"]},
        "payment_date_text": {"type": ["string", "null"]},
        "transaction_reference_text": {"type": ["string", "null"]}
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sources"],
      "properties": {
        "kind": {"type": "string", "enum": ["PROMISE_TIMING", "PROMISED_AMOUNT", "PAYMENT_CLAIM", "INVOICE_FACT", "OTHER_CANDIDATE"]},
        "sources": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/span"}}
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "sources"],
      "properties": {
        "field": {"type": "string", "enum": ["SPEAKER", "AMOUNT", "CURRENCY", "PROMISE_DATE", "PAYMENT_DATE", "PAYMENT_REFERENCE", "SUPERSESSION", "ATTRIBUTION"]},
        "sources": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/span"}}
      }
    }
  }
}
